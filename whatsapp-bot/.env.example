# Copie pra .env (gitignorado) e preencha com os valores reais.
# Nenhuma dessas variáveis deve ir pro repositório nem pro front-end do site.

# Mesmo projeto Supabase do site — o bot usa a service_role key (ignora RLS),
# igual o próprio site já faz no servidor.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# URL base do site Sizzle (produção), usada pra chamar /api/orders e
# /api/orders/preview, e pro link "ver cardápio no site" do bot.
SIZZLE_API_BASE_URL=https://seu-dominio.vercel.app

# Token secreto compartilhado com o site — precisa ser EXATAMENTE o mesmo
# valor configurado como WHATSAPP_BOT_API_TOKEN nas variáveis de ambiente da
# Vercel. Gere algo longo e aleatório, nunca reaproveite senha de outra coisa.
WHATSAPP_BOT_API_TOKEN=

# Depois de quantos minutos sem o cliente mandar mensagem a conversa reseta
# (volta pro início e esquece o carrinho).
SESSION_EXPIRY_MINUTES=30

# Limite de mensagens por cliente dentro da janela abaixo, pra evitar spam/flood.
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# Se o cliente pedir "atendente" e ninguém reativar pelo painel, o bot volta
# a responder automaticamente depois desse tempo (rede de segurança).
PAUSE_AUTO_EXPIRE_HOURS=4
